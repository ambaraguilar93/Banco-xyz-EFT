# Plantilla de secretos y parametros de Banco XYZ (EFT)
# Copiar a .env (esta en .gitignore) y completar.

# OAuth App de GitHub (callback: http://localhost:9000/login/oauth2/code/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Logins de GitHub (separados por coma) que reciben los scopes de escritura.
# Vacio = todos los usuarios autenticados.
AUTH_OPERADORES=

# Cliente del banco asociado a cada login de GitHub (claim clienteId de los BFF web y movil)
# Formato login:clienteId,login:clienteId. Los demas logins usan AUTH_CLIENTE_POR_DEFECTO.
AUTH_CLIENTES_GITHUB=
AUTH_CLIENTE_POR_DEFECTO=1

# PostgreSQL del docker-compose
DB_USER=postgres
DB_PASSWORD=hola123

# Version de PostgreSQL
POSTGRES_VERSION=17
